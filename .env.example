# Application
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Railway PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/asset_archaeologist

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Drive access mode:
# picker = recommended public mode using drive.file + Google Picker
# full   = full Drive scan using restricted drive.readonly scope
GOOGLE_DRIVE_ACCESS_MODE=picker

# Google Picker (required in picker mode)
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.8-27b:free
